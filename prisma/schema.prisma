// Definição do schema do banco de dados TripPulse.
// Fonte única de verdade para o Prisma Client e para as migrations.
// Conexão configurada em prisma.config.ts (datasource).

// Prisma 7: o client e "Rust-free" e exige um driver adapter em runtime
// (@prisma/adapter-pg, conectado em apps/api/src/config/prisma.js).
// O generator "prisma-client-js" gera o client consumivel nativamente pelo Node.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Contexto de uma viagem cadastrada pelo usuário.
// Base para o futuro monitoramento de ofertas.
model Trip {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  destination String
  // Origem da viagem: texto canônico de localização (ex.: "Curitiba, Paraná,
  // Brasil"), no mesmo padrão do destination. Nullable de propósito: viagens
  // legadas são preservadas sem backfill fictício; novas pesquisas exigem
  // origem (gate no flights.service) e novos cadastros a exigem no CRUD.
  origin      String?
  startDate   DateTime @map("start_date") @db.Date
  endDate     DateTime @map("end_date") @db.Date
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  flightOffers FlightOffer[]

  @@map("trips")
}

// Oferta de passagem observada em uma pesquisa para uma viagem.
// Identidade definida pela combinação de viagem + externalKey (provedor,
// rota, voo e partida): preços mudam, a oferta observada permanece.
model FlightOffer {
  id                 String   @id @default(uuid()) @db.Uuid
  tripId             String   @map("trip_id") @db.Uuid
  provider           String
  dataClassification String   @map("data_classification")
  type               String
  origin             String
  destination        String
  departureDate      DateTime @map("departure_date")
  arrivalDate        DateTime @map("arrival_date")
  airline            String
  flightNumber       String   @map("flight_number")
  stops              Int
  cabinClass         String   @map("cabin_class")
  baggagePieces      Int      @map("baggage_pieces")
  refundable         Boolean
  externalKey        String   @map("external_key")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  trip         Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  priceHistory PriceHistory[]

  @@unique([tripId, externalKey])
  @@map("flight_offers")
}

// Observação de preço de uma oferta em uma pesquisa (histórico).
model PriceHistory {
  id         String   @id @default(uuid()) @db.Uuid
  offerId    String   @map("offer_id") @db.Uuid
  currency   String
  total      Float
  base       Float
  taxes      Float
  observedAt DateTime @map("observed_at")

  flightOffer FlightOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@index([offerId, observedAt])
  @@map("price_history")
}

// Execução registrada do ciclo de monitoramento (Dia 11.3).
// Uma linha por execução: criada como RUNNING antes do ciclo e finalizada
// como COMPLETED ou FAILED no desfecho. Um RUNNING cujo processo morreu é
// recuperado como FAILED quando o heartbeat expira (ver monitoring.service).
//
// status: RUNNING | COMPLETED | FAILED. FAILED é falha GLOBAL do ciclo
// (aborto ou recuperação de órfão); falhas por viagem são dados do relatório
// (items/failedCount).
// trigger: MANUAL | SCHEDULED — vocabulário fechado já nesta migration para
// o agendador futuro não exigir mudança de schema.
model MonitoringRun {
  id               String    @id @default(uuid()) @db.Uuid
  status           String
  trigger          String
  startedAt        DateTime  @default(now()) @map("started_at")
  // Renovado durante o ciclo. Um RUNNING com heartbeat antigo perde a posse
  // e é marcado FAILED antes da próxima execução (nunca fica bloqueando o
  // índice parcial para sempre).
  heartbeatAt      DateTime  @default(now()) @map("heartbeat_at")
  finishedAt       DateTime? @map("finished_at")
  durationMs       Int?      @map("duration_ms")
  tripCount        Int       @default(0) @map("trip_count")
  monitorableCount Int       @default(0) @map("monitorable_count")
  skippedCount     Int       @default(0) @map("skipped_count")
  okCount          Int       @default(0) @map("ok_count")
  failedCount      Int       @default(0) @map("failed_count")
  opportunityCount Int       @default(0) @map("opportunity_count")
  items            Json
  // Motivo de FAILED (aborto global ou recuperação de execução órfã).
  failureReason    String?   @map("failure_reason")

  @@index([startedAt])
  @@map("monitoring_runs")
}
