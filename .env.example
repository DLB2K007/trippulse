# Configuração local da API TripPulse.
# Copie este arquivo para .env e ajuste os valores conforme o ambiente.

# Porta em que o servidor HTTP escuta.
PORT=3000

# Interface de rede escutada pelo servidor.
# 0.0.0.0 aceita conexões de qualquer interface (padrão para desenvolvimento).
HOST=0.0.0.0

# Agendador automático do monitoramento (execuções com trigger SCHEDULED).
# DESATIVADO por padrão: apenas 'true' ou '1' ativam; qualquer outro valor desativa.
MONITORING_SCHEDULER_ENABLED=false

# Intervalo entre ciclos automáticos, em milissegundos.
# Inteiro entre 60000 (1 min) e 86400000 (24 h). Quando ausente, o padrão é 900000 (15 min).
# Com o agendador ATIVO, um valor presente e inválido falha o boot (fail-fast).
MONITORING_SCHEDULER_INTERVAL_MS=900000

# Tempo máximo de espera pelo ciclo em voo durante o shutdown gracioso, em ms.
# Inteiro entre 1000 (1 s) e 60000 (60 s); quando ausente, o padrão é 10000 (10 s).
# Se expirar, o processo encerra mesmo assim e um RUNNING eventual é recuperado
# pelo heartbeat na próxima execução.
SHUTDOWN_TIMEOUT_MS=10000

# String de conexão do PostgreSQL local (docker compose up -d).
# Porta 5433 no host para não conflitar com um PostgreSQL local na 5432.
DATABASE_URL=postgresql://trippulse:trippulse@localhost:5433/trippulse?schema=public
