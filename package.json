{
  "name": "trippulse",
  "version": "0.1.0",
  "description": "Plataforma inteligente de monitoramento e comparacao de precos de viagens.",
  "type": "module",
  "main": "apps/api/src/server.js",
  "scripts": {
    "start": "node --env-file=.env apps/api/src/server.js",
    "dev": "node --env-file=.env --watch apps/api/src/server.js",
    "start:no-env": "node apps/api/src/server.js",
  "db:migrate": "prisma migrate dev && prisma generate",
  "db:deploy": "prisma migrate deploy",
  "postinstall": "prisma generate",
  "test": "node --env-file=.env --test --test-force-exit"
  },
  "engines": {
    "node": ">=20.6.0"
  },
  "license": "ISC",
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "dotenv": "^18.0.9",
    "fastify": "^5.12.8",
    "prisma": "^7.10.1"
  }
}
